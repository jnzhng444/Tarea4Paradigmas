{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "compile-network",
      "type": "shell",
      "command": "gcc",
      "args": [
        "-c",
        "${workspaceFolder}/ClienteC/network.c",
        "-o",
        "${workspaceFolder}/ClienteC/output/network.o",
        "-Wall", "-Wextra", "-O2"
      ],
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "build-raylib-client",
      "type": "shell",
      "command": "gcc",
      "args": [
        "${workspaceFolder}/ClienteC/raylib_client.c",
        "${workspaceFolder}/ClienteC/level.c",
        "${workspaceFolder}/ClienteC/output/network.o",
        "-o",
        "${workspaceFolder}/ClienteC/output/dkj_client.exe",
        "-I", "${workspaceFolder}/ClienteC",
        "-I", "C:/raylib/raylib-5.5_win64_mingw-w64/include",
        "-L", "C:/raylib/raylib-5.5_win64_mingw-w64/lib",
        "-lraylibdll",
        "-lws2_32",
        "-lopengl32",
        "-lgdi32",
        "-lwinmm",
        "-Wall", "-Wextra", "-O2"
      ],
      "dependsOn": ["compile-network"],
      "problemMatcher": ["$gcc"],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ]
}