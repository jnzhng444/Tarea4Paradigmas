{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build network",
            "type": "shell",
            "command": "mingw32-make.exe",
            "args": [
                "RAYLIB_PATH=C:/raylib/raylib",
                "PROJECT_NAME=network",
                "OBJS=ClienteC/network.c",
                "BUILD_MODE=DEBUG",
                "-C",
                "${workspaceFolder}"
            ],
            "problemMatcher": ["$gcc"],
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            }
        },
        {
            "label": "build debug",
            "type": "shell",
            "command": "mingw32-make.exe",
            "args": [
                "RAYLIB_PATH=C:/raylib/raylib",
                "PROJECT_NAME=dkj_client",
                "OBJS=ClienteC/raylib_client.c ClienteC/level.c ClienteC/network.c",
                "BUILD_MODE=DEBUG"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc"],
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            }
        },
        {
            "label": "build release",
            "type": "shell",
            "command": "mingw32-make.exe",
            "args": [
                "RAYLIB_PATH=C:/raylib/raylib",
                "PROJECT_NAME=dkj_client",
                "OBJS=ClienteC/raylib_client.c ClienteC/level.c ClienteC/network.c"
            ],
            "group": "build",
            "problemMatcher": ["$gcc"],
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            }
        },
        {
            "label": "clean",
            "type": "shell",
            "command": "mingw32-make.exe",
            "args": [
                "clean",
                "PROJECT_NAME=dkj_client"
            ],
            "problemMatcher": [],
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            }
        }
    ]
}